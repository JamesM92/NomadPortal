# NomadPortal optional configuration file.
#
# Copy this file to config/config.yml and edit to enable interfaces.
# The application also exposes interface configuration through the
# Admin → Settings UI, which writes back to this file.
#
# When this file exists, its `interfaces` block is rendered into the
# `[interfaces]` section of config/reticulum/config on each start.

interfaces:
  # AutoInterface — zero-config local network discovery (LAN/WiFi).
  auto:
    enabled: false

  # I2P tunnels — list of { name, b32, enabled }.
  i2p: []

  # RNode LoRa radios — list of devices (see admin UI for full schema).
  rnodes: []

  # TCP clients — connect to remote Reticulum hubs / testnet entry points.
  tcp_clients:
    - name: RNS Testnet Dublin
      host: dublin.connect.reticulum.network
      port: 4965
      enabled: false
    - name: RNS Testnet BetweenTheBorders
      host: reticulum.betweentheborders.com
      port: 4242
      enabled: false

  # Per-interface options can be added to any tcp_clients or tcp_servers
  # entry above:
  #
  #   ingress_control: false
  #     RNS defaults ingress_control=True on every interface, which
  #     rate-limits how many announces for previously-unknown
  #     destinations it will process per burst. On busy public hubs
  #     (michmesh, oklahoma, etc.) this holds/drops many announces
  #     that were briefly bursty, leaving the client with a much
  #     sparser path table than peers who happened to be listening
  #     during a quiet moment. Symptom: path lookups for destinations
  #     other clients on the same hub can reach fail with "Path not
  #     found." Setting ingress_control: false disables the limiter
  #     for that interface — recommended for TCP client links to
  #     public hubs where you want the fullest possible path table.
  #
  #   mode: full | access_point | gateway | roaming | boundary | ptp
  #     Controls how the interface participates in path discovery
  #     and other transport behaviours. Leave unset (RNS default =
  #     full) unless you know you need one of the others.

  # TCP servers — accept incoming Reticulum connections.
  tcp_servers: []

  # UDP interfaces.
  udp: []

# Transport mode: should this node forward traffic for OTHER peers
# in addition to handling its own destinations?
#
# Leaving this commented out auto-defaults based on whether you're
# hosting a site (SITE_HOSTING env var / Admin → Settings → Hosting):
#   - Hosting on  → transport on  (correct default — RNS 1.3+
#                                   requires this for inbound link
#                                   establishment to your site's
#                                   destination to complete reliably)
#   - Hosting off → transport off (leaf mode — no relay cost)
#
# Set explicitly to override the auto-default. Transport on means
# your node will route some other peers' announces and link traffic
# through, costing modest CPU/bandwidth. Only enable on always-on
# stationary hosts.
# transport_mode: true

# Set true to suppress responses to incoming Reticulum discovery probes.
# Outbound traffic on the interfaces below is unaffected — this only
# stops the node advertising its presence in reply to unsolicited probes
# (most relevant on multicast LANs / AutoInterface).
ignore_discovery_probes: false

# Reticulum shared-instance knobs. When `enabled` is true (the RNS default),
# any other RNS process reachable on the same loopback joins this instance —
# useful for one-host setups, problematic when running multiple NomadPortals
# in the same Docker network namespace (each will see the others' state).
# Set `enabled: false` per instance, or give each a unique `port`, to keep
# co-located instances independent. Leave port/control_port empty to use
# RNS defaults (37428 / 37429).
shared_instance:
  enabled: true
  instance_name: default
  port:
  control_port:
