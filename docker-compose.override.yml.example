# Local-only overrides for docker-compose.yml — copy this file to
# `docker-compose.override.yml` (which is gitignored) and fill in your
# real values. Compose auto-merges it on `docker compose up`.
#
# Use this for any setting you don't want committed to the public repo:
# OIDC client secrets, internal hostnames, paths specific to your host,
# alternate ports, etc.

services:
  nomadportal:
    environment:
      # ── Real OIDC / SSO settings (Authentik, Keycloak, Auth0, Google) ──
      # Generate the client + secret in your provider's UI; paste here.
      OIDC_CLIENT_ID:        ""
      OIDC_CLIENT_SECRET:    ""
      OIDC_DISCOVERY_URL:    ""
      # OIDC_ALLOWED_EMAILS:  "you@example.com,team@example.com"
      # OIDC_ADMIN_EMAILS:    "you@example.com"
      # If your OIDC provider uses a self-signed cert on a trusted LAN, set
      # this to "true". Do NOT use in production with a real cert.
      # OIDC_INSECURE_SKIP_VERIFY: "true"

      # ── Stable session key (override the empty default in docker-compose.yml) ──
      # Generate once with:  openssl rand -hex 32
      # FLASK_SECRET_KEY: ""

      # ── Strong admin password (override the placeholder "changeme") ──
      # ADMIN_PASSWORD: ""
