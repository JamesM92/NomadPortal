[bandit]
# Bandit security-linter config — paired with .github/workflows/security.yml
#
# Bandit's CI job runs `bandit -r . -ll` (MEDIUM+ severity only) and
# fails the workflow on any finding. This file documents the
# project-wide suppressions and *why* — so the next person who looks
# at a failed scan has the rationale here, not just in commit history.
#
# Note: bandit auto-discovers `.bandit` in INI format. YAML configs
# need an explicit `-c <file>` flag — we use the simple form here.
#
# B104 — hardcoded_bind_all_interfaces. Bandit flags `host="0.0.0.0"`
# in app.py, the gunicorn bind, and the redirect-HTTP server. All
# intentional: NomadPortal runs in a container where the container
# provides the network boundary (port-mapping, reverse-proxy,
# Gluetun VPN, etc.). Binding to 0.0.0.0 is the *correct* behaviour;
# binding to 127.0.0.1 would make the service unreachable from
# outside the container.
skips = B104
